# Copy this file to .env and fill in real values. .env is gitignored.
# Every config key the app reads lives here, with no secrets committed.

# LLM
LLM_PROVIDER=groq            # groq | gemini | ollama
LLM_MODEL=                   # set to the provider's current model id
GROQ_API_KEY=
GOOGLE_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
JUDGE_PROVIDER=groq
JUDGE_MODEL=

# Embeddings / reranker
EMBED_MODEL=BAAI/bge-small-en-v1.5
RERANK_MODEL=BAAI/bge-reranker-base
RERANK_TOP_N=4

# Retrieval
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=acme_docs
RETRIEVAL_TOP_K=12
HYBRID_ENABLED=true
RERANK_ENABLED=true
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# App
DATABASE_URL=sqlite:///./securerag.db
JWT_SECRET=change-me
JWT_EXPIRE_MINUTES=60
API_BASE_URL=http://localhost:8000

# Observability
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
